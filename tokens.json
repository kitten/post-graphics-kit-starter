{
  "$comment": "Single source of truth for the post-graphics kit. Colours: see README 'Colour mapping' (scripts/map_colors.py). Fonts: fonts.roles drive both HTML (variable axes) and Satori (static instances built by scripts/build-fonts.py).",
  "sizes": {
    "1600x900": {
      "w": 1600,
      "h": 900,
      "pad": 88,
      "use": "16:9 in-feed image / OG / link card"
    },
    "1200x1200": {
      "w": 1200,
      "h": 1200,
      "pad": 80,
      "use": "1:1 in-feed image"
    },
    "1080x1350": {
      "w": 1080,
      "h": 1350,
      "pad": 72,
      "use": "4:5 portrait in-feed image: tallest image X/LinkedIn show uncropped on phones. Use for tall/dense diagrams and long tables."
    },
    "2000x1000": {
      "w": 2000,
      "h": 1000,
      "pad": 96,
      "use": "2:1 wide: wide/dense diagrams, gantt, many-column tables. Shown uncropped in-feed on X when single image."
    }
  },
  "scale": 2,
  "radii": {
    "node": 10,
    "pill": 999,
    "card": 28,
    "bar": 14,
    "badge": 999
  },
  "spacing": {
    "xs": 6,
    "sm": 12,
    "md": 20,
    "lg": 32,
    "xl": 48,
    "xxl": 72
  },
  "fonts": {
    "roles": {
      "trDisplay": {
        "source": "tailrecursive",
        "satoriFamily": "TR Display",
        "axes": {
          "wght": 940,
          "CASL": 0.88,
          "CRSV": 0,
          "wdth": 100,
          "slnt": 0
        },
        "from": "kitten.sh .article h1 (4.5em, wght 940, CASL 0.88, CRSV 0, line-height 0.9)"
      },
      "trTitle": {
        "source": "tailrecursive",
        "satoriFamily": "TR Title",
        "axes": {
          "wght": 900,
          "CASL": 1,
          "CRSV": 0.5,
          "wdth": 100,
          "slnt": 0
        },
        "from": "OG/X title card look (matched against SDK 54 post image)"
      },
      "trHeading": {
        "source": "tailrecursive",
        "satoriFamily": "TR Heading",
        "axes": {
          "wght": 815,
          "CASL": 0.1,
          "CRSV": 0.5,
          "wdth": 104,
          "slnt": 0
        },
        "from": "kitten.sh .content h2 (wght 815, CASL 0.1, stretch 104%)"
      },
      "trSubheading": {
        "source": "tailrecursive",
        "satoriFamily": "TR Subheading",
        "axes": {
          "wght": 665,
          "CASL": 0.76,
          "CRSV": 0.5,
          "wdth": 105,
          "slnt": 0
        },
        "from": "kitten.sh h3 (wght 665, CASL 0.76, stretch 105%)"
      },
      "trBody": {
        "source": "tailrecursive",
        "satoriFamily": "TR Body",
        "axes": {
          "wght": 380,
          "CASL": 0,
          "CRSV": 0.5,
          "wdth": 100,
          "slnt": 0
        },
        "from": "kitten.sh .content body text (380); also small/caption text (colour 'small')"
      },
      "trBold": {
        "source": "tailrecursive",
        "satoriFamily": "TR Bold",
        "axes": {
          "wght": 720,
          "CASL": 0,
          "CRSV": 0.5,
          "wdth": 100,
          "slnt": 0
        },
        "from": "kitten.sh b/strong (720)"
      },
      "trMono": {
        "source": "tailrecursive",
        "satoriFamily": "TR Mono",
        "axes": {
          "wght": 450,
          "CASL": 0,
          "CRSV": 0.5,
          "wdth": 140,
          "slnt": 0
        },
        "from": "kitten.sh inline code (450, stretch 140% = monospace)"
      },
      "trMonoBold": {
        "source": "tailrecursive",
        "satoriFamily": "TR Mono Bold",
        "axes": {
          "wght": 720,
          "CASL": 0,
          "CRSV": 0.5,
          "wdth": 140,
          "slnt": 0
        },
        "from": "derived: bold code"
      },
      "trNumber": {
        "source": "tailrecursive",
        "satoriFamily": "TR Number",
        "axes": {
          "wght": 480,
          "CASL": 0.4,
          "CRSV": 0.5,
          "wdth": 100,
          "slnt": 0
        },
        "from": "kitten.sh .number (480, CASL 0.4)"
      },
      "inter400": {
        "source": "inter",
        "satoriFamily": "Inter 400",
        "axes": {
          "wght": 400,
          "opsz": 14
        }
      },
      "inter500": {
